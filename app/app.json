{
  "expo": {
    "name": "Rohingya English",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO", "CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Rohingya English uses the microphone to record your speech for translation."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rohingya English uses the camera to translate text in photos.",
          "photosPermission": "Rohingya English uses your photos to translate text."
        }
      ]
    ],
    "scheme": "rwcapp",
    "backgroundColor": "#EEF4FF"
  }
}
