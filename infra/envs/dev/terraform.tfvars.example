# Copy to terraform.tfvars (gitignored) and fill in.
alert_email              = "team-alerts@example.org"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Full apply only (step 5 in infra/README.md): the git SHA the Deploy workflow pushed.
# image_tag = "0123abcd..."

# monthly_budget_usd      = 45
# memory_size             = 4096
# reserved_concurrency    = null   # leave null on new accounts
# provisioned_concurrency = 0      # >0 removes cold starts, billed hourly
